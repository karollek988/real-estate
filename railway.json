{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/api/**",
      "/analysis_engine/**",
      "/BRF-Scraper/**",
      "/src/**",
      "/Dockerfile",
      "/railway.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 50
  }
}
