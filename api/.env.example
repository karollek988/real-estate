# Environment for the Python service (api/server.py + analysis_engine +
# src/location_intelligence + src/market_intelligence). Names only - never put
# real values in this file.
#
# The service does not load a .env file by itself. In production the values
# live in Railway's service variables. Locally, copy this file to api/.env
# (gitignored) and start the service from api/ with:
#   uvicorn server:app --port 8000 --env-file .env

# Required: shared secret that every request except the health page "/" must
# send as the X-Internal-Secret header (require_internal_secret in server.py).
# Must be exactly the same value as PYTHON_ENGINE_API_SECRET in the Next.js
# app's environment (frontend/.env.example). If unset, every request gets a 500;
# if it doesn't match, a 401.
PYTHON_ENGINE_API_SECRET=

# Optional: how many Camoufox (Firefox) browsers /api/browser-fetch may run at
# once. Default 1 - each launch peaks near 0.9 GB, so raise it only when the
# Railway plan has the memory for it. Keep commented out for the default: an
# empty value is not a number and stops the service from starting.
# MAX_CONCURRENT_BROWSER_FETCHES=1

# Optional: Trafikverket Open API key (free, data.trafikverket.se) for the
# location engine's infrastructure provider. Without it, that provider reports
# "not_connected".
TRAFIKVERKET_API_KEY=

# Optional: Lantmäteriet Geotorget OAuth client (organization account) for the
# detaljplan provider. Without both, that provider reports "not_connected".
LANTMATERIET_CLIENT_ID=
LANTMATERIET_CLIENT_SECRET=

# Optional: comma-separated provider ids to skip in the location and market
# engines, e.g. DISABLED_PROVIDERS=osm_amenities,smhi_climate
DISABLED_PROVIDERS=

# Optional tuning for the location (LI_*) and market (MI_*) engines
# (src/*/config.py), shown with their defaults. Keep commented out unless you
# change them - an empty number fails the engine's config check.
# LI_CACHE_DIR=.cache/location_intelligence
# LI_HTTP_TIMEOUT_S=10
# LI_MAX_WORKERS=8
# LI_DEFAULT_DEADLINE_S=20
# MI_CACHE_DIR=.cache/market_intelligence
# MI_HTTP_TIMEOUT_S=10
# MI_MAX_WORKERS=8
# MI_DEFAULT_DEADLINE_S=20

# Not used by the web service - only by the command-line tool
# `python analysis_engine/run.py --ai` (the OpenAI narrator).
OPENAI_API_KEY=

# PORT is set by Railway; locally uvicorn's --port decides (8000 by default).
