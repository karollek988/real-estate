NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start

# Server-only: service-role key for the analysis pipeline. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-start

# Server-only: Booli Listing API v2 credentials (docs/data-source-inventory.md
# entry 1 — key issued on request at booli.se). Without these, the Booli
# provider correctly reports "not_connected" rather than faking data.
BOOLI_CALLER_ID=
BOOLI_API_KEY=

# Server-only: Trafikverket Open API key (free, issued on request at
# data.trafikverket.se). Without it, that provider reports "not_connected".
TRAFIKVERKET_API_KEY=

# Server-only: Trafiklab ResRobot v2.1 API key (free, CC0-licensed, covers
# all Swedish public transit — SL, Västtrafik, Skånetrafiken, etc. — under
# one key; sign up at trafiklab.se). Powers commute-time transit figures.
# Without it, the commute provider reports "not_connected". Car/walk times
# use OSRM's free public routing server and need no key.
TRAFIKLAB_RESROBOT_API_KEY=

# Server-only: Parse.bot's "Booli.se API" scraper-as-a-service
# (https://parse.bot/marketplace/e0286288-9caf-40e1-83f2-eb4dbbc95fab/booli-se-api).
# A fallback data source, used only when Hemnet and the direct Booli API
# above leave a field missing — see identityTrust.ts. Free tier: 100
# credits/month, 5 req/min; the provider skips its own network calls when
# nothing is missing, to avoid spending credits needlessly. Known
# limitations (see parseBotBooli.ts header for detail, verified live
# 2026-07-23): no image/floor-plan URL field and no broker person name;
# more seriously, search_listings_for_sale's `query` parameter does not
# actually filter by location despite Parse.bot's own docs claiming it
# does, so in practice this provider rarely finds an address match today —
# it fails safe (never merges the wrong property) rather than fails loud.
# Without these two vars, the provider correctly reports "not_connected"
# rather than faking data.
PARSE_API_KEY=
# Fixed scraper-instance URL for this integration (confirmed live 2026-07-22):
# https://api.parse.bot/scraper/62c0a0dc-f695-46ab-be29-04b903ed21c7
PARSE_BOOLI_BASE_URL=

# Optional: comma-separated provider ids to disable without a code change,
# e.g. DISABLED_PROVIDERS=osm_amenities,smhi_climate
DISABLED_PROVIDERS=

# Server-only: Resend API key (resend.com). Required for the contact form
# (frontend/src/app/api/contact/route.ts) AND for the branded auth emails
# sent from frontend/src/app/api/auth/send-email/route.ts. Without it, both
# fail with contact_unavailable / a 500 from the Send Email Hook. Sending to
# arbitrary recipients (not just your own Resend account email) requires a
# verified sending domain in the Resend dashboard.
RESEND_API_KEY=
# Sender shown on outgoing auth emails, e.g. "Köpanalys <info@kopanalys.se>".
# The domain in this address must be verified in Resend.
RESEND_FROM_EMAIL=

# Server-only: absolute base URL of the deployed site, used to build the
# logo <img> src in outgoing HTML emails (the Send Email Hook route has no
# request "origin" to derive it from, unlike normal page routes).
NEXT_PUBLIC_SITE_URL=

# Server-only: shared secret for verifying Supabase's Send Email Auth Hook
# (Standard Webhooks signature, format "v1,whsec_<base64>"). For a hosted
# project, get this from Supabase Dashboard > Authentication > Hooks after
# adding the "Send Email" HTTP hook pointing at /api/auth/send-email. For
# local `supabase start`, any value works as long as it matches
# supabase/config.toml's [auth.hook.send_email].
SEND_EMAIL_HOOK_SECRET=

# Server-only: the three one-time Stripe Prices that are sold (lib/pricing.ts
# holds the SEK amounts shown on the site, lib/stripe/prices.ts what each
# purchase credits). Create each once in the Stripe Dashboard — a Price's amount
# can't be edited, so a price change means a new Price and a new id here.
#   Områdesanalys    99 kr  (SEK, incl. VAT, one-time)
#   Trygghetspaket  499 kr  (one-time)
#   Tre bostäder    999 kr  (one-time)
# Without one of these, checkout for that package fails with a 500 and
# nothing is charged.
STRIPE_PRICE_OMRADESANALYS=
STRIPE_PRICE_TRYGGHETSPAKET=
STRIPE_PRICE_TRE_BOSTADER=

# Server-only: one Stripe Coupon (50% off, duration "once") used for every
# discount code (issue_discount_code() in the database creates the codes).
# Create it once in the Stripe Dashboard and do NOT restrict it to particular
# products. Without it, a valid discount code is reserved but checkout session
# creation fails (the coupon can't be resolved).
STRIPE_COUPON_ANALYSIS_50OFF=

# Server-only: base URL of the Python FastAPI service (api/server.py) that
# hosts the Location/Market Intelligence engine bridge endpoints
# (/api/location-intelligence, /api/market-intelligence). Without this,
# both providers correctly report "not_connected" rather than faking data.
PYTHON_ENGINE_API_URL=http://127.0.0.1:8000

# Server-only: shared secret sent as the X-Internal-Secret header on every
# request to PYTHON_ENGINE_API_URL (see lib/pythonEngine.ts) — that service
# has no auth of its own, so this is what stops anyone who finds its URL
# from calling it directly. Must match PYTHON_ENGINE_API_SECRET set in the
# Python service's own environment (Railway, or your local shell when
# running api/server.py directly) exactly, or every call fails with 401.
PYTHON_ENGINE_API_SECRET=

# Server-only: signs the admin portal's session cookie (admin.kopanalys.se; see
# src/lib/admin/session.ts). At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key derived from SUPABASE_SERVICE_ROLE_KEY is used instead; if
# neither is set, admin login is disabled in production (it fails closed).
ADMIN_SESSION_SECRET=

# Server-only, optional: scrypt hash of the admin portal password. The password
# itself is never stored anywhere - only a hash, and one is already built into
# src/lib/admin/credentials.ts. Set this to override it (rotate the password)
# without a code change: run `npm run admin:hash`, paste the printed value here.
# Changing it signs every existing admin session out.
ADMIN_PASSWORD_HASH=

# Server-only: who may use the BRF review console (/admin/brf) — the people
# who review and publish BRF analyses (lib/auth/admin.ts). Comma-separated;
# the account's email must be confirmed. Without it, only the founder's
# account (karollek98@gmail.com) is a reviewer.
KOPANALYS_ADMIN_EMAILS=
# Server-only: where "a BRF review is due" emails go (lib/brf/notify.ts).
# Comma-separated. Without it: kopanalys@gmail.com (the contact-form inbox).
KOPANALYS_TEAM_EMAILS=
# Optional, development only: BRF review emails are sent only in production;
# set to "on" to send them from `next dev` too (they go to real addresses).
BRF_REVIEW_EMAILS=

# Server-only, optional: secret for the anonymous daily visitor value behind the
# visitor statistics (src/lib/analytics/visitor.ts). At least 32 random characters.
# Without it a key is derived from SUPABASE_SERVICE_ROLE_KEY, so this is only for
# keeping the two apart. Changing it makes everyone count as a new visitor once.
ANALYTICS_HASH_SECRET=
# Optional, development only: set to "1" to show made-up numbers on the admin
# portal's statistics page (clearly labelled as demo data) without a database.
# Ignored in production.
ADMIN_STATS_DEMO=
