# BRF Scraper Environment Configuration
# Copy this file to .env and fill in the values

# Application
APP_NAME=brf-scraper
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_LOG_FORMAT=json

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///data/brf_scraper.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/brf_scraper

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20

# HTTP Client
HTTP_TIMEOUT=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1.0
HTTP_USER_AGENT=BRF-Scraper/0.1.0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=2.0
RATE_LIMIT_BURST=5

# Crawler
CRAWLER_MAX_CONCURRENT_REQUESTS=10
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_DEFAULT_DEPTH=2

# Downloader
DOWNLOADER_CHUNK_SIZE=8192
DOWNLOADER_MAX_FILE_SIZE=104857600  # 100MB
DOWNLOADER_ENABLE_RESUME=true

# Storage
STORAGE_PDF_DIR=data/pdfs
STORAGE_EXPORT_DIR=data/exports

# Extraction
EXTRACTOR_OCR_ENABLED=false
EXTRACTOR_OCR_ENGINE=paddleocr
EXTRACTOR_MIN_CONFIDENCE=0.7

# Export
EXPORT_FORMAT=json
EXPORT_COMPRESS=false

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_CRON=0 2 * * 0  # Every Sunday at 2 AM
